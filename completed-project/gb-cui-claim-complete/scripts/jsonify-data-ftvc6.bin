// convert JSON payload to object
/*
from website:
{
    "firstName":"Greg",
    "LastName":"Bousley"
}
*/

function mapData() {
    let webHookDataObject = JSON.parse(variables.var_inboundRequest);
    // map your process variables from the webHookDataObject here: 
    // ex: variables.var_firstName = webHookDataObject.FirstName;
    variables.var_firstName = webHookDataObject.firstName;
    variables.var_lastName = webHookDataObject.lastName;
    variables.var_email = webHookDataObject.streetAddress;
    variables.var_firstName = webHookDataObject.city;
    variables.var_firstName = webHookDataObject.state;
    variables.var_firstName = webHookDataObject.zip;
    variables.var_firstName = webHookDataObject.email;
    variables.var_firstName = webHookDataObject.damageType;
    variables.var_firstName = webHookDataObject.damageDate;
    variables.var_firstName = webHookDataObject.damageDescription;
    variables.var_firstName = webHookDataObject.imageFile;
}


try {
    mapData();
} catch (error)
{
    console.error("webHookDataObject does not have value");
    throw error;
}