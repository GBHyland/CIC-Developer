const inbound = variables.var_inboundRequest || null;

// Get array safely
let uploadedImages = [];

if (inbound) {
    if (typeof inbound.get === "function") {
        uploadedImages = inbound.get("var_uploadedImages") || [];
    } else {
        uploadedImages = inbound.var_uploadedImages || [];
    }
}

// Ensure it's an array
if (!Array.isArray(uploadedImages)) {
    uploadedImages = [];
}

// Get current index safely as a number
let currentIndex = Number(variables.var_imageNum || 0);

// Increment FIRST since current image already finished processing
currentIndex = currentIndex + 1;

// Save updated index
variables.var_imageNum = currentIndex;

// Decide whether there is another image to process
if (currentIndex >= uploadedImages.length) {
    variables.var_processImage = false;
    variables.var_uploadedFileUrl = "";
} else {
    variables.var_processImage = true;
    variables.var_uploadedFileUrl = String(uploadedImages[currentIndex] || "");
}

