
/*  What can be used?
*  1 - Input Variables Example:
*          const cost = variables.cost;
*          const taxes = variables.taxes[0];
*
*  2 - Output Variables Example:
*          variables.totalCost = cost * (1 + taxes);
*
*  3 - Runtime Commands (ProcessPayloadBuilder and CommandProducer) Example:
*          const startProcessInstanceCmd = processPayloadBuilder.start().withProcessDefinitionKey('1af40357-b122-4de1-a031-a71630cbdf33').build();
*          commandProducer.send(startProcessInstanceCmd);
*
*  4 - Runtime APIs Example. The following APIs are currently supported: ProcessInstanceAdminControllerApi, ProcessInstanceControllerApi, ProcessInstanceTasksControllerApi, ProcessInstanceVariableAdminControllerApi, ProcessInstanceVariableControllerApi, TaskAdminControllerApi, TaskControllerApi, TaskVariableAdminControllerApi and TaskVariableControllerApi.
*
*  Examples for the different APIs:
*
*       4.1.- runtimeProcessInstanceAdminService (it includes ProcessInstanceAdminControllerApi and ProcessInstanceVariableAdminControllerApi):
*
*           const startProcessPayload = { businessKey: variables.businessKey, payloadType: 'StartProcessPayload', processDefinitionKey: variables.processKey };
*           const runtimeProcessInstanceAdminService = new RuntimeProcessInstanceAdminService();
*           runtimeProcessInstanceAdminService.startProcess(startProcessPayload);
*
*       4.2.- runtimeProcessInstanceService (it includes ProcessInstanceControllerApi, ProcessInstanceTasksControllerApi and ProcessInstanceVariableControllerApi):
*
*           const startProcessPayload = { businessKey: variables.businessKey, payloadType: 'StartProcessPayload', processDefinitionKey: variables.processKey };
*           const runtimeProcessInstanceService = new RuntimeProcessInstanceService();
*           runtimeProcessInstanceService.startProcess(startProcessPayload);
*
*       4.3.- runtimeTaskService (it includes TaskControllerApi and TaskVariableControllerApi):
*
*           const assignTaskPayload = { assignee: variables.assignee, id: '08fdd393-eb2c-4026-85aa-3801f71294d9', payloadType: 'AssignTaskPayload', taskId: 'id-task-1' };
*           const runtimeTaskService = new RuntimeTaskService();
*           runtimeTaskService.assign('id-task-1', assignTaskPayload);
*
*       4.4.- runtimeTaskAdminService (it includes TaskAdminControllerApi and TaskVariableAdminControllerApi):
*
*           const assignTaskPayload = { assignee: variables.assignee, id: '08fdd393-eb2c-4026-85aa-3801f71294d9', payloadType: 'AssignTaskPayload', taskId: 'id-task-1' };
*           const runtimeTaskAdminService = new RuntimeTaskAdminService();
*           runtimeTaskAdminService.assign('id-task-1', assignTaskPayload);
*
*  5 - Query APIs Example. The following APIs are currently supported: ProcessInstanceAdminControllerApi, ProcessInstanceControllerApi, ProcessInstanceDeleteControllerApi, ProcessInstanceDiagramAdminControllerApi, ProcessInstanceDiagramControllerApi, ProcessInstanceServiceTasksAdminControllerApi, ProcessInstanceTasksControllerApi, ProcessInstanceVariableAdminControllerApi, ProcessInstanceVariableControllerApi, TaskAdminControllerApi, TaskControllerApi, TaskVariableAdminControllerApi and TaskVariableControllerApi.
*
*  Examples for the different APIs:
*
*       5.1.- queryProcessInstanceAdminService (it includes ProcessInstanceAdminControllerApi, ProcessInstanceDiagramAdminControllerApi, ProcessInstanceServiceTasksAdminControllerApi and ProcessInstanceVariableAdminControllerApi):
*
*           const queryProcessInstanceAdminService = new QueryProcessInstanceAdminService();
*           queryProcessInstanceAdminService.findById('idProcess');
*
*       5.2.- queryProcessInstanceService (it includes ProcessInstanceControllerApi, ProcessInstanceDeleteControllerApi, ProcessInstanceDiagramControllerApi, ProcessInstanceTasksControllerApi and ProcessInstanceVariableControllerApi):
*
*           const queryProcessInstanceService = new QueryProcessInstanceService();
*           queryProcessInstanceService.findById('idProcess');
*
*       5.3.- queryTaskAdminService (it includes TaskAdminControllerApi and TaskVariableAdminControllerApi):
*
*           const queryTaskAdminService = new QueryTaskAdminService();
*           queryTaskAdminService.findById('idTask');
*
*       5.4.- queryTaskService (it includes TaskControllerApi and TaskVariableControllerApi):
*
*           const queryTaskService = new QueryTaskService();
*           queryTaskService.findById('idTask');
*
*  6 - Form APIs Example. The following APIs are currently supported: FormApi.
*
*  Examples for the different APIs:
*
*       6.1.- FormService (it includes FormApi):
*
*           const formId = variables.formId;
*           const formService = new FormService();
*           const form = formService.getFormDefinition(formId);
*
*  7 - Content Repository APIs Example. The following APIs are currently supported: CheckinApi, CopyApi, DocumentApi, ModelApi, MoveApi, QueryApi, RenditionsApi, VocabularyApi, BulkImportApi, DocumentPermissionsApi, SecurityApi, GroupApi, UserApi, VersionApi, RenditionConfigurationsApi.
*
*   *** PLEASE NOTE: for some actions the script runtime client must be granted as administrator ***
*
*  Examples for the different APIs:
*
*       7.1.- CheckinApi:
*           Object: CheckinApi
*           Available Methods: checkin
*           Example:
*               Checkin a provided document:
*               const checkinApi = new CheckinApi();
*               const document = checkinApi.checkin(variables.docId, null);
*               variables.document = document;
*
*       7.2.- CopyApi:
*           Object: CopyApi
*           Available Methods: copy
*           Example:
*               Copies the source document inside the destination folder:
*               const copyApi = new CopyApi();
*               const document = copyApi.copy(variables.docId, null, { name: 'My copied file', targetParentId: variables.targetParentId });
*               variables.document = document;
*
*       7.3.- DocumentApi:
*           Object: DocumentApi
*           Available Methods: getDocumentById, getDocumentByPath, getDocumentAncestors, createDocumentUnderParentById,
*               createDocumentUnderParentByPath, patchDocumentById, patchDocumentByPath, updateDocumentById, updateDocumentByPath
*           Example:
*               Creates a document under parent with given id:
*               const documentApi = new DocumentApi();
*               const document = documentApi.createDocumentUnderParentById(variables.targetParentId, null, { sys_primaryType: 'SysFile', sys_title: 'My file' });
*               variables.document = document;
*
*       7.4.- ModelApi:
*           Object: ModelApi
*           Available Methods: getModel, patchModel, setModel, setModelItemsForProject
*           Example:
*               Returns the model for the repository:
*               const modelApi = new ModelApi();
*               const model = modelApi.getModel(null);
*               variables.model = model;
*
*       7.5.- MoveApi:
*           Object: MoveApi
*           Available Methods: move
*           Example:
*               Moves the source document to the provided destination:
*               const moveApi = new MoveApi();
*               const document = moveApi.move(variables.docId, null, { targetParentId: variables.targetParentId });
*               variables.document = document;
*
*       7.6.- QueryApi:
*           Object: QueryApi
*           Available Methods: getNamedQueries, getNamedQuery, getDocumentsByNamedQuery, getDocumentsByAdvancedQuery,
*               getDocumentsByQuery, waitForFullTextSearchIndexing
*           Example:
*               Returns the search results for given repository:
*               const queryApi = new QueryApi();
*               const queryResult = queryApi.getDocuments({ query: "SELECT * FROM SysFolder WHERE sys_title like '%Insurance%'", limit: 25, offset: 0});
*               variables.documents = queryResult.documents;
*
*       7.7.- RenditionsApi:
*           Object: RenditionsApi
*           Available Methods: getRenditions, getRendition, createRendition
*           Example:
*               Create a new rendition for the given document:
*               const renditionsApi = new RenditionsApi();
*               const document = renditionsApi.createRendition(variables.docId, null, { sysrendition_id: variables.renditionId });
*               variables.document = document;
*
*       7.8.- VocabularyApi:
*           Object: VocabularyApi
*           Available Methods: createVocabulary, createVocabularyEntry, getVocabularyEntries, updateVocabularyEntry,
*               getVocabularyEntry, getVocabularyList, deleteVocabularyEntry, deleteVocabulary
*           Example:
*               Creates a vocabulary:
*               const vocabularyApi = new VocabularyApi();
*               const vocabulary = vocabularyApi.createVocabulary(null, { sysvocab_id: 'MyVocabulary' });
*               variables.vocabulary = vocabulary;
*
*       7.9.- BulkImportApi:
*           Object: BulkImportApi
*           Available Methods: getJobs, createJob, getJobById, startJobById
*           Example:
*               Gets bulk import Jobs:
*               const bulkImportApi = new BulkImportApi();
*               const bulk = bulkImportApi.getJobs();
*               variables.bulk = bulk;
*
*       7.10.- DocumentPermissionsApi:
*           Object: DocumentPermissionsApi
*           Available Methods: fulleffectiveacl, fulleffectivepermissions
*           Example:
*               Fetch the full list of effective ACL on the document:
*               const documentPermissionsApi = new DocumentPermissionsApi();
*               const listEffectiveACLDTO = documentPermissionsApi.fulleffectiveacl(variables.docId, variables.userId, null);
*               variables.listEffectiveACLDTO = listEffectiveACLDTO;
*
*       7.11.- UserApi:
*           Object: UserApi
*           Available Methods: getUserById, searchUsersByName
*           Example:
*               Returns the user with given id:
*               const userApi = new UserApi();
*               const user = userApi.getUserById(variables.userId);
*               variables.user = user;
*
*       7.12.- GroupApi:
*           Object: GroupApi
*           Available Methods: getGroupById, searchGroups
*           Example:
*               Search groups containing a substring:
*               const groupApi = new GroupApi();
*               const groups = groupApi.searchGroups('admin');
*               variables.groups = groups;
*
*       7.13.- SecurityApi:
*           Object: SecurityApi
*           Available Methods: getSecurityPolicies, patchSecurityPolicies, setSecurityPolicies, setSecurityPoliciesForProject
*           Example:
*               Returns the configured Security Policies:
*               const securityApi = new SecurityApi();
*               const secPolicies = securityApi.getSecurityPolicies();
*               variables.secPolicies = secPolicies;
*
*       7.14.- VersionApi:
*           Object: VersionApi
*           Available Methods: restoreVersion
*           Example:
*               Restores the document to a given version:
*               const versionApi = new VersionApi();
*               const version = versionApi.restoreVersion(variables.version_sys_id);
*               variables.version = version;
*
*       7.15.- RenditionConfigurationsApi:
*           Object: RenditionConfigurationsApi
*           Available Methods: putRenditions
*           Example:
*               Update rendition configurations for a project:
*               const renditionConfigApi = new RenditionConfigurationsApi();
*               const rc = renditionConfigApi.putRenditions(variables.projectId, false, null, variables.renditionsConfig);
*               variables.rc = rc;
*
*/